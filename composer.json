{
    "name": "tornado-engine/docs",
    "description": "Tornado Engine core-module: documentation pages in Administration. Other modules add their own docs.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "TornadoEngine\\Docs\\": "src/"
        }
    },
    "extra": {
        "tornado": {
            "name": "Docs",
            "prompt": "Help pages: $docs->add(...).",
            "core": ">=0.3",
            "core-module": true,
            "provider": "TornadoEngine\\Docs\\DocsServiceProvider"
        },
        "branch-alias": {
            "dev-main": "0.5.x-dev"
        }
    }
}
